{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build:tokens && npm run build:content && npm run build:posts",
    "dev": "next dev",
    "prebuild": "npm run build:tokens && npm run build:content && npm run build:posts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "build:tokens": "tsx scripts/build-tokens.ts",
    "build:content": "tsx scripts/build-content.ts",
    "build:media": "tsx scripts/build-media.ts",
    "build:audio": "tsx scripts/build-audio.ts",
    "check:copy": "tsx scripts/check-copy.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "build:cantos": "tsx scripts/build-cantos.ts",
    "build:posts": "tsx scripts/build-posts.ts"
  },
  "dependencies": {
    "motion": "^13.2.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.0",
    "sharp": "^0.35.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "lighthouse": "^13.4.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
