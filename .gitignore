# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# o modelo, sem segredos, é versionado
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# relatórios brutos do Lighthouse (o HTML fica versionado)
docs/lighthouse/**/*.report.json

# tabela das placas com as 70 UHs: gerada por npm run qa:qr -- --csv, fora do repositório enquanto ele for público
docs/qr-codes.csv
# Resultado do QA dos QR Codes: lista as 70 UHs com nome e destino, como a tabela das placas
docs/qa/etapa-6/qr-*.json
