# Fase do site: pre (pré-inauguração) ou full (site completo)
NEXT_PUBLIC_SITE_PHASE=pre

# URL pública, sem barra final. Em produção, exatamente https://kaluanaecohotel.com.br
NEXT_PUBLIC_SITE_URL=https://kaluanaecohotel.com.br

# Página Eventos e menções ao auditório: só true com autorização do cliente
NEXT_PUBLIC_EVENTOS_AUTORIZADO=false

# Motor de reservas. Vazio = botão Reservar leva a /reservas
NEXT_PUBLIC_RESERVAS_URL=

# Google Tag Manager (setup técnico da agência). Vazio = GTM não carrega
NEXT_PUBLIC_GTM_ID=

# Formulários (server actions). Sem RESEND_API_KEY o envio é simulado, exceto no deploy de
# produção, onde vira erro e o build para (scripts/check-env.ts, docs/deploy.md).
RESEND_API_KEY=
LEAD_FROM_EMAIL=site@kaluanaecohotel.com.br
# Um ou mais destinos, separados por vírgula
LEAD_TO_EMAIL=

# Bloqueia GPTBot e CCBot no robots.txt, sem mexer em busca nem em robôs de resposta.
# O padrão libera, que é a recomendação da Parte 4.6 do documento mestre.
NEXT_PUBLIC_BLOQUEAR_TREINO_IA=false

# VERCEL_ENV é definida pela própria Vercel (production ou preview). Num build local,
# VERCEL_ENV=production reproduz o de produção: sem avisos internos de revisão.
